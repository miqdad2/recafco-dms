# Development stack secrets template (deploy/dev/compose.yaml).
# Do not fill this in by hand: run `node scripts/dev-env.mjs`, which creates
# deploy/dev/.env with random values (never printed). Never commit that file.
RECAFCO_DEV_MAYAN_PORT=8091
RECAFCO_DEV_DB_PASSWORD=
RECAFCO_DEV_REDIS_PASSWORD=
RECAFCO_DEV_PASSWORD_EMPLOYEE_A=
RECAFCO_DEV_PASSWORD_EMPLOYEE_B=
RECAFCO_DEV_PASSWORD_CONTROLLER=
RECAFCO_DEV_PASSWORD_ADMIN=
# Optional: host names Mayan accepts (default: localhost and 127.0.0.1 only).
# Add a LAN address only for an approved demonstration; never use a wildcard.
# RECAFCO_DEV_ALLOWED_HOSTS=['localhost', '127.0.0.1', '192.0.2.10']
