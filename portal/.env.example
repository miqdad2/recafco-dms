# Portal configuration template. Copy to portal/.env.local and fill in.
# In development, `node scripts/dev-env.mjs` creates portal/.env.local with
# random values instead. Never commit the real file.

# Mayan base URL, reachable from the portal server only.
MAYAN_URL=http://127.0.0.1:8091

# 64 hex characters (32 random bytes). Encrypts Mayan tokens in the session
# database. Keep secret; changing it signs everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_SESSION_KEY=

PORTAL_SESSION_IDLE_MINUTES=30
PORTAL_SESSION_ABSOLUTE_HOURS=8
PORTAL_MAX_UPLOAD_MB=50

# Optional. Default: portal/.data/sessions.sqlite (git ignored).
# PORTAL_SESSION_DB=

# Optional. Default: true in production builds (needs HTTPS).
# PORTAL_COOKIE_SECURE=true
